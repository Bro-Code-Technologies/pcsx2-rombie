#include <winres.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ROMBIE_ENGINE_VERSION_MAJOR,ROMBIE_ENGINE_VERSION_MINOR,ROMBIE_ENGINE_VERSION_PATCH,0
 PRODUCTVERSION ROMBIE_ENGINE_VERSION_MAJOR,ROMBIE_ENGINE_VERSION_MINOR,ROMBIE_ENGINE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bro Code Technologies"
            VALUE "FileDescription", "Rombie PS2 Engine"
            VALUE "FileVersion", ROMBIE_ENGINE_VERSION
            VALUE "InternalName", "pcsx2-rombie"
            VALUE "LegalCopyright", "GPLv3. Built from PCSX2 (pcsx2.net)."
            VALUE "OriginalFilename", "rombie-ps2-engine.exe"
            VALUE "ProductName", "Rombie PS2 Engine"
            VALUE "ProductVersion", ROMBIE_ENGINE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
